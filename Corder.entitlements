<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <false/>
    <!-- Removed 2026-06-02 along with the move to Developer ID +
         universal-binary notarized builds. `Sparkle.framework` is now
         re-signed with our Team ID (PDB9JGGX74) during build, so
         hardened-runtime library validation passes without the
         opt-out. Dropping the entitlement lowers our Gatekeeper risk
         score, Apple's malware-scan path treats apps with fewer
         hardening opt-outs as lower-risk, which removes the "Apple
         could not verify Corder is free of malware" diagnostic that
         was firing on cleanly-notarized builds on tester Macs.
         Re-add ONLY if Sparkle starts failing with
         "Library Validation failed: Rejecting"-class errors and
         re-signing the framework in-place no longer helps. -->
    <!-- <key>com.apple.security.cs.disable-library-validation</key> -->
    <!-- <true/> -->
    <!-- Sign in with Apple capability is registered for
         com.3mpq.Corder on developer.apple.com (2026-05-25).
         The `com.apple.developer.applesignin` entitlement is
         temporarily disabled because adding it causes launchd
         to refuse the binary (RBSRequestErrorDomain 5,
         NSPOSIXErrorDomain 163), even when signed with the
         Developer ID identity and hardened runtime. Hypothesis:
         macOS Developer ID builds want an embedded
         provisioning profile (`embedded.provisionprofile` in
         the .app bundle) carrying this capability before the
         system trusts the entitlement. Wire that up next, then
         re-add the key. -->
    <!-- TODO: Universal Links via
         `com.apple.developer.associated-domains` + applinks:getcorder.com.
         Pulled because self-signed dev builds need a provisioning
         profile carrying that capability, without it launchd
         rejects the binary (RBSRequestErrorDomain 5, NSPOSIXErrorDomain
         163), same failure mode as the parked `applesignin` entitlement
         above. Re-add once notarized Developer ID builds ship with
         an embedded provisioning profile that includes the
         associated-domains capability. Until then OAuth uses the
         legacy `corder://` custom scheme (one-time "Open Corder.app?"
         browser prompt). -->
</dict>
</plist>
